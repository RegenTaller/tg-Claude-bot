# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ из https://platform.claude.com (Settings → API keys). Расходы списываются с этого аккаунта.
ANTHROPIC_API_KEY=
# Кто может пользоваться ботом: Telegram ID через запятую (узнать свой — команда /id в боте)
ALLOWED_USER_IDS=
# Кто может выдавать доступ командами /allow и /deny и видит расход всех в /usage.
# Обычно — только ваш ID. Если оставить пустым, этими командами не сможет пользоваться никто.
ADMIN_USER_IDS=
# Модель и effort по умолчанию для новых пользователей
DEFAULT_MODEL=claude-opus-5-5
DEFAULT_EFFORT=medium
# Максимальная длина одного ответа в токенах, включая размышления модели (1024–128000)
MAX_TOKENS=64000
# Месячный лимит расходов на одного пользователя в долларах (0 — без лимита; на админов не действует)
USER_MONTHLY_LIMIT_USD=0
# Через сколько дней удалять историю брошенных диалогов (0 — хранить вечно)
HISTORY_RETENTION_DAYS=30
# Сколько памяти можно занять контейнеру бота (обычно ~200 МБ, на больших PDF до ~450 МБ)
BOT_MEM_LIMIT=1g
